<div class="item-tooltip-container">

    <img
        src="@Image"
        alt="@Name"
        class="item-tooltip-image"
        style="width: @(ImageSize)px; height: @(ImageSize)px;" />

    <strong class="item-tooltip-name">
        @Name
    </strong>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <div class="item-tooltip-content">

            <strong>@Name</strong>

            <p>@RenderDescription(Description)</p>

        </div>
    }

</div>

@code {

    [Parameter]
    public string Image { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Description { get; set; } = "";

    [Parameter]
    public int ImageSize { get; set; } = 110;

    private static readonly Dictionary<string, string> DescriptionColors = new()
    {
        ["{YELLOW}"] = "#e8c252",
        ["{ORANGE}"] = "#ff8800",
        ["{GREEN}"] = "#199b1e",
        ["{CYAN}"] = "#2f9cd6",
        ["{PURPLE}"] = "#ac3ee3",
        ["{CITATION}"] = "#e7cda2"
    };

    private MarkupString RenderDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return new MarkupString("");
        }

        string result = description;

        foreach (var color in DescriptionColors)
        {
            result = result.Replace(
                color.Key,
                $"<span style=\"color:{color.Value};\">"
            );
        }

        result = result.Replace(
            "{RESET}",
            "</span>"
        );

        return new MarkupString(result);
    }
}

