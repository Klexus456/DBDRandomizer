@page "/settings"

@using DBDRandomizer.Models
@using DBDRandomizer.Data
@using DBDRandomizerWeb.Services
@using DBDRandomizer.Randomizer

<h1>CONFIGURACIÓN</h1>

<p class="settings-description">
    Desde aquí puedes configurar qué elementos puede utilizar
    el randomizador.
</p>

@if (loading)
{
    <div class="settings-loading">
        <p>Cargando configuración...</p>
    </div>
}
else
{
    <div class="settings-container">

    <!-- ========================= -->
    <!-- SKIN RANDOMIZATION -->
    <!-- ========================= -->

    <details class="settings-section">
        <summary class="settings-section-summary">
            <div>
                <h2>Skin Randomization</h2>
                <p>
                    Elige cómo se randomizarán las skins.
                </p>
            </div>
        </summary>

        <div class="settings-section-content">

            <div class="skin-randomization-setting">

                <h3>Survivor</h3>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="survivor-skin-mode"
                        checked="@(config.SurvivorSkinMode == SkinRandomizationMode.Parts)"
                        @onchange="() => config.SurvivorSkinMode = SkinRandomizationMode.Parts" />

                    <span>
                        Piezas separadas
                    </span>
                </label>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="survivor-skin-mode"
                        checked="@(config.SurvivorSkinMode == SkinRandomizationMode.Outfit)"
                        @onchange="() => config.SurvivorSkinMode = SkinRandomizationMode.Outfit" />

                    <span>
                        Outfit completo
                    </span>
                </label>

                <h3>Killer</h3>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="killer-skin-mode"
                        checked="@(config.KillerSkinMode == SkinRandomizationMode.Parts)"
                        @onchange="() => config.KillerSkinMode = SkinRandomizationMode.Parts" />

                    <span>
                        Piezas separadas
                    </span>
                </label>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="killer-skin-mode"
                        checked="@(config.KillerSkinMode == SkinRandomizationMode.Outfit)"
                        @onchange="() => config.KillerSkinMode = SkinRandomizationMode.Outfit" />

                    <span>
                        Outfit completo
                    </span>
                </label>

            </div>

        </div>
    </details>

        <!-- ========================= -->
        <!-- SURVIVORS -->
        <!-- ========================= -->

        <details class="settings-section">

            <summary class="settings-section-summary">
                <div>
                    <h2>Survivors</h2>
                    <p>
                        @EnabledSurvivorsCount de @survivors.Count habilitados
                    </p>
                </div>
            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivors">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivors">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="item-search">
                    <input
                        type="text"
                        placeholder="Buscar Survivor..."
                        @bind="survivorSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-list">

                    @foreach (Survivor survivor in FilteredSurvivors)
                    {
                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsSurvivorEnabled(survivor.Id)"
                                @onchange="() => ToggleSurvivor(survivor.Id)" />

                            <span>
                                @survivor.Name
                            </span>

                        </label>
                    }

                </div>

            </div>

        </details>

        <!-- ========================= -->
        <!-- KILLERS -->
        <!-- ========================= -->

        <details class="settings-section">

            <summary class="settings-section-summary">
                <div>
                    <h2>Killers</h2>
                    <p>
                        @EnabledKillersCount de @killers.Count habilitados
                    </p>
                </div>
            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillers">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillers">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="item-search">
                    <input
                        type="text"
                        placeholder="Buscar Killer..."
                        @bind="killerSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-list">

                    @foreach (Killer killer in FilteredKillers)
                    {
                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsKillerEnabled(killer.Id)"
                                @onchange="() => ToggleKiller(killer.Id)" />

                            <span>
                                @killer.Name
                            </span>

                        </label>
                    }

                </div>

            </div>

        </details>
        
        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>
                    <h2>Survivor Skins</h2>

                    <p>
                        Configura qué skins pueden utilizarse.
                    </p>
                </div>

            </summary>


            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorSkins">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorSkins">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Survivor o skin..."
                        @bind="survivorSkinSearch"
                        @bind:event="oninput" />

                </div>


                <div class="skin-list">

                    @foreach (Survivor survivor in FilteredSurvivorsForSkins)
                    {
                        <details class="skin-character">

                            <summary>
                                <strong>@survivor.Name</strong>
                            </summary>

                            <div class="skin-character-content">

                                @{
                                    IEnumerable<IGrouping<int, SkinPiece>> outfits =
                                        GetVisibleOutfits(survivor.Id);

                                    IEnumerable<IGrouping<int, SkinPiece>> separableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => skin.IsSeparable));

                                    IEnumerable<IGrouping<int, SkinPiece>> inseparableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => !skin.IsSeparable));
                                }


                                @if (separableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Piezas separables</h4>

                                        @foreach (var outfitGroup in separableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <h5>
                                                    @GetOutfitName(outfitGroup)
                                                </h5>

                                                @foreach (
                                                    SkinPart part in GetAvailableParts(outfitGroup)
                                                )
                                                {
                                                    <div class="skin-part">

                                                        <strong>@part</strong>

                                                        @foreach (
                                                            SkinPiece skin in GetSkinsForPart(
                                                                outfitGroup,
                                                                part
                                                            )
                                                        )
                                                        {
                                                            <label class="settings-item">

                                                                <input
                                                                    type="checkbox"
                                                                    checked="@IsSkinEnabled(skin.Id)"
                                                                    @onchange="
                                                                        () => ToggleSkin(skin.Id)" />

                                                                <span>
                                                                    @skin.Name
                                                                </span>

                                                            </label>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }


                                @if (inseparableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Outfits completos</h4>

                                        @foreach (var outfitGroup in inseparableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <label class="settings-item">

                                                    <input
                                                        type="checkbox"
                                                        checked="@IsOutfitEnabled(outfitGroup)"
                                                        @onchange="
                                                            () => ToggleOutfit(outfitGroup)" />

                                                    <span>
                                                        @GetOutfitName(outfitGroup)
                                                    </span>

                                                </label>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </details>
                    }

                </div>

            </div>

        </details>

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>
                    <h2>Killer Skins</h2>

                    <p>
                        Configura qué skins pueden utilizarse.
                    </p>
                </div>

            </summary>


            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillerSkins">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillerSkins">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Killer o skin..."
                        @bind="killerSkinSearch"
                        @bind:event="oninput" />

                </div>


                <div class="skin-list">

                    @foreach (Killer killer in FilteredKillersForSkins)
                    {
                        <details class="skin-character">

                            <summary>
                                <strong>@killer.Name</strong>
                            </summary>

                            <div class="skin-character-content">

                                @{
                                    IEnumerable<IGrouping<int, SkinPiece>> outfits =
                                        GetVisibleKillerOutfits(killer.Id);

                                    IEnumerable<IGrouping<int, SkinPiece>> separableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => skin.IsSeparable));

                                    IEnumerable<IGrouping<int, SkinPiece>> inseparableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => !skin.IsSeparable));
                                }


                                @if (separableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Piezas separables</h4>

                                        @foreach (var outfitGroup in separableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <h5>
                                                    @GetOutfitName(outfitGroup)
                                                </h5>

                                                @foreach (
                                                    SkinPart part in GetAvailableParts(outfitGroup)
                                                )
                                                {
                                                    <div class="skin-part">

                                                        <strong>@part</strong>

                                                        @foreach (
                                                            SkinPiece skin in GetSkinsForPart(
                                                                outfitGroup,
                                                                part
                                                            )
                                                        )
                                                        {
                                                            <label class="settings-item">

                                                                <input
                                                                    type="checkbox"
                                                                    checked="@IsKillerSkinEnabled(skin.Id)"
                                                                    @onchange="
                                                                        () => ToggleKillerSkin(skin.Id)" />

                                                                <span>
                                                                    @skin.Name
                                                                </span>

                                                            </label>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }


                                @if (inseparableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Outfits completos</h4>

                                        @foreach (var outfitGroup in inseparableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <label class="settings-item">

                                                    <input
                                                        type="checkbox"
                                                        checked="@IsKillerOutfitEnabled(outfitGroup)"
                                                        @onchange="
                                                            () => ToggleKillerOutfit(outfitGroup)" />

                                                    <span>
                                                        @GetOutfitName(outfitGroup)
                                                    </span>

                                                </label>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </details>
                    }

                </div>

            </div>

        </details>



        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Survivor Perks</h2>

                    <p>
                        @EnabledSurvivorPerksCount de @survivorPerks.Count habilitadas
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorPerks">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorPerks">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="perk-search">
                    <input
                        type="text"
                        placeholder="Buscar Survivor o perk..."
                        @bind="survivorPerkSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-list">

                    @foreach (Perk perk in FilteredSurvivorPerks)
                    {
                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsSurvivorPerkEnabled(perk.Id)"
                                @onchange="() => ToggleSurvivorPerk(perk.Id)" />

                            <span>
                                @perk.Name
                            </span>

                        </label>
                    }

                </div>

            </div>

        </details>

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Killer Perks</h2>

                    <p>
                        @EnabledKillerPerksCount de @killerPerks.Count habilitadas
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillerPerks">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillerPerks">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="perk-search">

                    <input
                        type="text"
                        placeholder="Buscar Killer o perk..."
                        @bind="killerPerkSearch"
                        @bind:event="oninput" />

                </div>

                <div class="settings-list">

                    @foreach (Perk perk in FilteredKillerPerks)
                    {
                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsKillerPerkEnabled(perk.Id)"
                                @onchange="() => ToggleKillerPerk(perk.Id)" />

                            <span>
                                @perk.Name
                            </span>

                        </label>
                    }

                </div>

            </div>

        </details>

        <!-- *=========================* -->
        <!-- SURVIVOR ADD-ONS -->
        <!-- *=========================* -->

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Survivor Add-ons</h2>

                    <p>
                        @EnabledSurvivorAddonsCount de @SurvivorAddons.Count() habilitados
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorAddons">

                        HABILITAR TODOS

                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorAddons">

                        DESHABILITAR TODOS

                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Item o addon..."
                        @bind="survivorAddonSearch"
                        @bind:event="oninput" />

                </div>

                <div class="skin-list">

                    @foreach (Item item in FilteredItemsForSurvivorAddons)
                    {
                        IEnumerable<Addon> itemAddons =
                            GetVisibleSurvivorAddons(item.Id);

                        @if (itemAddons.Any())
                        {
                            <details class="skin-character">

                                <summary>

                                    <strong>@item.Name</strong>

                                </summary>

                                <div class="skin-character-content">

                                    @foreach (Addon addon in itemAddons)
                                    {
                                        <label class="settings-item">

                                            <input
                                                type="checkbox"
                                                checked="@IsAddonEnabled(addon.Id)"
                                                @onchange="
                                                    () => ToggleAddon(addon.Id)" />

                                            <span>
                                                @addon.Name
                                            </span>

                                        </label>
                                    }

                                </div>

                            </details>
                        }
                    }

                </div>

            </div>

        </details>

        <!-- *=========================* -->
        <!-- KILLER ADD-ONS -->
        <!-- *=========================* -->

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Killer Add-ons</h2>

                    <p>
                        @EnabledKillerAddonsCount de @KillerAddons.Count() habilitados
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillerAddons">

                        HABILITAR TODOS

                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillerAddons">

                        DESHABILITAR TODOS

                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Killer o addon..."
                        @bind="killerAddonSearch"
                        @bind:event="oninput" />

                </div>

                <div class="skin-list">

                    @foreach (Killer killer in FilteredKillersForAddons)
                    {
                        IEnumerable<Addon> killerAddons =
                            GetVisibleKillerAddons(killer.Id);

                        @if (killerAddons.Any())
                        {
                            <details class="skin-character">

                                <summary>

                                    <strong>@killer.Name</strong>

                                </summary>

                                <div class="skin-character-content">

                                    @foreach (Addon addon in killerAddons)
                                    {
                                        <label class="settings-item">

                                            <input
                                                type="checkbox"
                                                checked="@IsAddonEnabled(addon.Id)"
                                                @onchange="
                                                    () => ToggleAddon(addon.Id)" />

                                            <span>
                                                @addon.Name
                                            </span>

                                        </label>
                                    }

                                </div>

                            </details>
                        }
                    }

                </div>

            </div>

        </details>

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Items</h2>

                    <p>
                        @EnabledItemsCount de @items.Count habilitados
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllItems">

                        HABILITAR TODOS

                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllItems">

                        DESHABILITAR TODOS

                    </button>

                </div>

                <div class="item-search">

                    <input
                        type="text"
                        placeholder="Buscar item..."
                        @bind="itemSearch"
                        @bind:event="oninput" />

                </div>

                <div class="settings-list">

                    @foreach (Item item in FilteredItems)
                    {
                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsItemEnabled(item.Id)"
                                @onchange="() => ToggleItem(item.Id)" />

                            <span>
                                @item.Name
                            </span>

                        </label>
                    }

                </div>

            </div>

        </details>

        <!-- ========================= -->
        <!-- OFFERINGS -->
        <!-- ========================= -->

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Offerings</h2>

                    <p>
                        @EnabledOfferingsCount de @offerings.Count habilitados
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllOfferings">

                        HABILITAR TODOS

                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllOfferings">

                        DESHABILITAR TODOS

                    </button>

                </div>

                <div class="item-search">

                    <input
                        type="text"
                        placeholder="Buscar offering..."
                        @bind="offeringSearch"
                        @bind:event="oninput" />

                </div>

                <div class="settings-list">

                    @foreach (Offering offering in FilteredOfferings)
                    {

                        <label class="settings-item">

                            <input
                                type="checkbox"
                                checked="@IsOfferingEnabled(offering.Id)"
                                @onchange="() => ToggleOffering(offering.Id)" />

                            <span>
                                @offering.Name
                            </span>

                        </label>

                    }

                </div>

            </div>

        </details>

        @if (validationErrors.Count > 0)
        {
            <div class="settings-validation-errors">

                <h3>CONFIGURACIÓN INVÁLIDA</h3>

                <p>
                    No se pueden guardar los cambios porque
                    el randomizador no podría funcionar correctamente.
                </p>

                <ul>
                    @foreach (string error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>

            </div>
        }

        <div class="settings-save-container">

            <button
                class="settings-save-button"
                @onclick="SaveConfig">

                GUARDAR CAMBIOS

            </button>

        </div>

    </div>
}


@code
{
    [Inject]
    private LocalStorageService LocalStorage { get; set; } = default!;

    [Inject]
    private HttpClient Http { get; set; } = default!;
    private List<Survivor> survivors = new();
    private List<Killer> killers = new();
    private RandomizerConfig config = new();
    private bool loading = true;
    private List<SkinPiece> survivorSkins = new();
    private List<SkinPiece> killerSkins = new();
    private string survivorSkinSearch = "";
    private string killerSkinSearch = "";
    private List<Perk> survivorPerks = new();
    private List<Perk> killerPerks = new();
    private string survivorPerkSearch = "";
    private string killerPerkSearch = "";
    private List<Item> items = new();
    private string itemSearch = "";
    private List<Addon> addons = new();
    private string survivorAddonSearch = "";
    private string killerAddonSearch = "";
    private List<Offering> offerings = new();
    private string offeringSearch = "";
    private string survivorSearch = "";
    private string killerSearch = "";
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        WebDataLoader loader = new(Http);

        survivors = await loader.LoadSurvivors();

        survivorSkins = await loader.LoadSurvivorSkins();

        survivorPerks = await loader.LoadSurvivorPerks();

        killers = await loader.LoadKillers();

        killerSkins = await loader.LoadKillerSkins();
           
        killerPerks = await loader.LoadKillerPerks();

        items = await loader.LoadItems();

        config = await loader.LoadConfig();

        addons = await loader.LoadAddons();

        offerings = await loader.LoadOfferings();

        loading = false;

        // Intentar cargar configuración guardada
        RandomizerConfig? savedConfig = await LocalStorage.LoadConfig();

        if (savedConfig != null)
        {
            config = savedConfig;
        }   

    }


    // =========================================================
    // SURVIVORS
    // =========================================================

    private bool IsSurvivorEnabled(int id)
    {
        return !config.DisabledSurvivors.Contains(id);
    }


    private void ToggleSurvivor(int id)
    {
        if (config.DisabledSurvivors.Contains(id))
        {
            config.DisabledSurvivors.Remove(id);
        }
        else
        {
            config.DisabledSurvivors.Add(id);
        }

    }


    private void EnableAllSurvivors()
    {
        config.DisabledSurvivors.Clear();
    }


    private void DisableAllSurvivors()
    {
        config.DisabledSurvivors = survivors
            .Select(survivor => survivor.Id)
            .ToList();
    }


    private int EnabledSurvivorsCount =>
        survivors.Count(survivor =>
            !config.DisabledSurvivors.Contains(survivor.Id));


    // =========================================================
    // KILLERS
    // =========================================================

    private bool IsKillerEnabled(int id)
    {
        return !config.DisabledKillers.Contains(id);
    }


    private void ToggleKiller(int id)
    {
        if (config.DisabledKillers.Contains(id))
        {
            config.DisabledKillers.Remove(id);
        }
        else
        {
            config.DisabledKillers.Add(id);
        }
    }


    private void EnableAllKillers()
    {
        config.DisabledKillers.Clear();
    }


    private void DisableAllKillers()
    {
        config.DisabledKillers = killers
            .Select(killer => killer.Id)
            .ToList();
    }


    private int EnabledKillersCount =>
        killers.Count(killer =>
            !config.DisabledKillers.Contains(killer.Id));

    // =========================================================
    // SURVIVOR SKINS
    // =========================================================

    private IEnumerable<Survivor> FilteredSurvivorsForSkins
    {
        get
        {
