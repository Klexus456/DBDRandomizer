@page "/settings"

@using DBDRandomizer.Models
@using DBDRandomizer.Data
@using DBDRandomizerWeb.Services
@using DBDRandomizer.Randomizer

<div class="settings-header">

    <h1>CONFIGURACIÓN</h1>

    <p>
        Personalizá los elementos que puede utilizar el randomizador.
    </p>

</div>

@if (loading)
{
    <div class="settings-loading">
        <p>Cargando configuración...</p>
    </div>
}
else
{
    <div class="settings-container">

    <!-- ========================= -->
    <!-- SKIN RANDOMIZATION -->
    <!-- ========================= -->

    <details class="settings-section">
        <summary class="settings-section-summary">
            <div>
                <h2>Skin Randomization</h2>
                <p>
                    Elige cómo se randomizarán las skins.
                </p>
            </div>
        </summary>

        <div class="settings-section-content">

            <div class="skin-randomization-setting">

                <h3>Survivor</h3>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="survivor-skin-mode"
                        checked="@(config.SurvivorSkinMode == SkinRandomizationMode.Parts)"
                        @onchange="() => config.SurvivorSkinMode = SkinRandomizationMode.Parts" />

                    <span>
                        Piezas separadas
                    </span>
                </label>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="survivor-skin-mode"
                        checked="@(config.SurvivorSkinMode == SkinRandomizationMode.Outfit)"
                        @onchange="() => config.SurvivorSkinMode = SkinRandomizationMode.Outfit" />

                    <span>
                        Outfit completo
                    </span>
                </label>

                <h3>Killer</h3>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="killer-skin-mode"
                        checked="@(config.KillerSkinMode == SkinRandomizationMode.Parts)"
                        @onchange="() => config.KillerSkinMode = SkinRandomizationMode.Parts" />

                    <span>
                        Piezas separadas
                    </span>
                </label>

                <label class="settings-item">
                    <input
                        type="radio"
                        name="killer-skin-mode"
                        checked="@(config.KillerSkinMode == SkinRandomizationMode.Outfit)"
                        @onchange="() => config.KillerSkinMode = SkinRandomizationMode.Outfit" />

                    <span>
                        Outfit completo
                    </span>
                </label>

            </div>

        </div>
    </details>

    <!-- ========================= -->
    <!-- EMPTY SLOTS -->
    <!-- ========================= -->
    <details class="settings-section">

        <summary class="settings-section-summary">

            <div>

                <h2>Empty Slots</h2>

                <p>
                    Configura la probabilidad de que un elemento salga vacío.
                </p>

            </div>

        </summary>

        <div class="settings-section-content">

            <div class="empty-slot-settings">

                <div class="empty-slot-setting">

                    <label for="perk-empty-chance">
                        Perks vacías
                    </label>

                    <div class="empty-slot-control">

                        <input
                            id="perk-empty-chance"
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.PerkEmptyChance" />

                        <input
                            type="number"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.PerkEmptyChance" />

                        <span>%</span>

                    </div>

                </div>


                <div class="empty-slot-setting">

                    <label for="item-empty-chance">
                        Item vacío
                    </label>

                    <div class="empty-slot-control">

                        <input
                            id="item-empty-chance"
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.ItemEmptyChance" />

                        <input
                            type="number"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.ItemEmptyChance" />

                        <span>%</span>

                    </div>

                </div>


                <div class="empty-slot-setting">

                    <label for="addon-empty-chance">
                        Add-ons vacíos
                    </label>

                    <div class="empty-slot-control">

                        <input
                            id="addon-empty-chance"
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.AddonEmptyChance" />

                        <input
                            type="number"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.AddonEmptyChance" />

                        <span>%</span>

                    </div>

                </div>


                <div class="empty-slot-setting">

                    <label for="offering-empty-chance">
                        Offering vacío
                    </label>

                    <div class="empty-slot-control">

                        <input
                            id="offering-empty-chance"
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.OfferingEmptyChance" />

                        <input
                            type="number"
                            min="0"
                            max="100"
                            step="1"
                            @bind="config.OfferingEmptyChance" />

                        <span>%</span>

                    </div>

                </div>

            </div>

        </div>

    </details>



        <!-- ========================= -->
        <!-- SURVIVORS -->
        <!-- ========================= -->

        <details class="settings-section">

            <summary class="settings-section-summary">
                <div>
                    <h2>Survivors</h2>
                    <p>
                        @EnabledSurvivorsCount de @survivors.Count habilitados
                    </p>
                </div>
            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivors">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivors">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="item-search">
                    <input
                        type="text"
                        placeholder="Buscar Survivor..."
                        @bind="survivorSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-character-list">

                    @foreach (Survivor survivor in FilteredSurvivors)
                    {
                        <label class="settings-character-item">

                            <input
                                type="checkbox"
                                checked="@IsSurvivorEnabled(survivor.Id)"
                                @onchange="() => ToggleSurvivor(survivor.Id)" />

                            <img
                                class="settings-character-image"
                                src="@survivor.Image"
                                alt="@survivor.Name" />

                            <div class="settings-visual-item-info">

                                <span class="settings-visual-item-name">
                                    @survivor.Name
                                </span>

                                <span class="settings-visual-item-subtitle">
                                    Survivor
                                </span>

                            </div>

                        </label>
                    }

                </div>

            </div>

        </details>

        <!-- ========================= -->
        <!-- KILLERS -->
        <!-- ========================= -->

        <details class="settings-section">

            <summary class="settings-section-summary">
                <div>
                    <h2>Killers</h2>
                    <p>
                        @EnabledKillersCount de @killers.Count habilitados
                    </p>
                </div>
            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillers">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillers">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="item-search">
                    <input
                        type="text"
                        placeholder="Buscar Killer..."
                        @bind="killerSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-character-list">

                    @foreach (Killer killer in FilteredKillers)
                    {
                        <label class="settings-character-item">

                            <input
                                type="checkbox"
                                checked="@IsKillerEnabled(killer.Id)"
                                @onchange="() => ToggleKiller(killer.Id)" />

                            <img
                                class="settings-character-image"
                                src="@killer.Image"
                                alt="@killer.Name" />

                            <div class="settings-visual-item-info">

                                <span class="settings-visual-item-name">
                                    @killer.Name
                                </span>

                                <span class="settings-visual-item-subtitle">
                                    Killer
                                </span>

                            </div>

                        </label>
                    }

                </div>

            </div>

        </details>
        
        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>
                    <h2>Survivor Skins</h2>

                    <p>
                        Configura qué skins pueden utilizarse.
                    </p>
                </div>

            </summary>


            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorSkins">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorSkins">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Survivor o skin..."
                        @bind="survivorSkinSearch"
                        @bind:event="oninput" />

                </div>


                <div class="skin-list">

                    @foreach (Survivor survivor in FilteredSurvivorsForSkins)
                    {
                        <details class="skin-character">

                            <summary>
                                <strong>@survivor.Name</strong>
                            </summary>

                            <div class="skin-character-content">

                                @{
                                    IEnumerable<IGrouping<int, SkinPiece>> outfits =
                                        GetVisibleOutfits(survivor.Id);

                                    IEnumerable<IGrouping<int, SkinPiece>> separableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => skin.IsSeparable));

                                    IEnumerable<IGrouping<int, SkinPiece>> inseparableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => !skin.IsSeparable));
                                }


                                @if (separableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Piezas separables</h4>

                                        @foreach (var outfitGroup in separableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <h5>
                                                    @GetOutfitName(outfitGroup)
                                                </h5>

                                                @foreach (
                                                    SkinPart part in GetAvailableParts(outfitGroup)
                                                )
                                                {
                                                    <div class="skin-part">

                                                        <strong>@part</strong>

                                                        @foreach (
                                                            SkinPiece skin in GetSkinsForPart(
                                                                outfitGroup,
                                                                part
                                                            )
                                                        )
                                                        {
                                                            <label class="skin-visual-item">

                                                                <input
                                                                    type="checkbox"
                                                                    checked="@IsSkinEnabled(skin.Id)"
                                                                    @onchange="() => ToggleSkin(skin.Id)" />

                                                                <img
                                                                    class="settings-skin-image"
                                                                    src="@skin.Image"
                                                                    alt="@skin.Name" />

                                                                <div class="settings-visual-item-info">

                                                                    <span class="settings-visual-item-name">
                                                                        @skin.Name
                                                                    </span>

                                                                    <span class="settings-visual-item-subtitle">
                                                                        @skin.Part
                                                                    </span>

                                                                </div>

                                                            </label>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }


                                @if (inseparableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Outfits completos</h4>

                                        @foreach (var outfitGroup in inseparableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <label class="skin-visual-item">

                                                    <input
                                                        type="checkbox"
                                                        checked="@IsOutfitEnabled(outfitGroup)"
                                                        @onchange="() => ToggleOutfit(outfitGroup)" />

                                                    @{
                                                        SkinPiece? previewSkin = outfitGroup.FirstOrDefault();
                                                    }

                                                    @if (previewSkin != null)
                                                    {
                                                        <img
                                                            class="settings-skin-image"
                                                            src="@previewSkin.Image"
                                                            alt="@GetOutfitName(outfitGroup)" />
                                                    }

                                                    <div class="settings-visual-item-info">

                                                        <span class="settings-visual-item-name">
                                                            @GetOutfitName(outfitGroup)
                                                        </span>

                                                        <span class="settings-visual-item-subtitle">
                                                            Outfit completo
                                                        </span>

                                                    </div>

                                                </label>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </details>
                    }

                </div>

            </div>

        </details>

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>
                    <h2>Killer Skins</h2>

                    <p>
                        Configura qué skins pueden utilizarse.
                    </p>
                </div>

            </summary>


            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillerSkins">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillerSkins">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Killer o skin..."
                        @bind="killerSkinSearch"
                        @bind:event="oninput" />

                </div>


                <div class="skin-list">

                    @foreach (Killer killer in FilteredKillersForSkins)
                    {
                        <details class="skin-character">

                            <summary>
                                <strong>@killer.Name</strong>
                            </summary>

                            <div class="skin-character-content">

                                @{
                                    IEnumerable<IGrouping<int, SkinPiece>> outfits =
                                        GetVisibleKillerOutfits(killer.Id);

                                    IEnumerable<IGrouping<int, SkinPiece>> separableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => skin.IsSeparable));

                                    IEnumerable<IGrouping<int, SkinPiece>> inseparableOutfits =
                                        outfits.Where(outfit =>
                                            outfit.All(skin => !skin.IsSeparable));
                                }


                                @if (separableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Piezas separables</h4>

                                        @foreach (var outfitGroup in separableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <h5>
                                                    @GetOutfitName(outfitGroup)
                                                </h5>

                                                @foreach (
                                                    SkinPart part in GetAvailableParts(outfitGroup)
                                                )
                                                {
                                                    <div class="skin-part">

                                                        <strong>@part</strong>

                                                        @foreach (
                                                            SkinPiece skin in GetSkinsForPart(
                                                                outfitGroup,
                                                                part
                                                            )
                                                        )
                                                        {
                                                            <label class="skin-visual-item">

                                                                <input
                                                                    type="checkbox"
                                                                    checked="@IsKillerSkinEnabled(skin.Id)"
                                                                    @onchange="() => ToggleKillerSkin(skin.Id)" />
                                                                <img
                                                                    class="settings-skin-image"
                                                                    src="@skin.Image"
                                                                    alt="@skin.Name" />

                                                                <div class="settings-visual-item-info">

                                                                    <span class="settings-visual-item-name">
                                                                        @skin.Name
                                                                    </span>

                                                                    <span class="settings-visual-item-subtitle">
                                                                        @skin.Part
                                                                    </span>

                                                                </div>

                                                            </label>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }


                                @if (inseparableOutfits.Any())
                                {
                                    <div class="skin-category">

                                        <h4>Outfits completos</h4>

                                        @foreach (var outfitGroup in inseparableOutfits)
                                        {
                                            <div class="skin-outfit">

                                                <label class="skin-visual-item">

                                                    <input
                                                        type="checkbox"
                                                        checked="@IsKillerOutfitEnabled(outfitGroup)"
                                                        @onchange="() => ToggleKillerOutfit(outfitGroup)" />

                                                    @{
                                                        SkinPiece? previewSkin = outfitGroup.FirstOrDefault();
                                                    }

                                                    @if (previewSkin != null)
                                                    {
                                                        <img
                                                            class="settings-skin-image"
                                                            src="@previewSkin.Image"
                                                            alt="@GetOutfitName(outfitGroup)" />
                                                    }

                                                    <div class="settings-visual-item-info">

                                                        <span class="settings-visual-item-name">
                                                            @GetOutfitName(outfitGroup)
                                                        </span>

                                                        <span class="settings-visual-item-subtitle">
                                                            Outfit completo
                                                        </span>

                                                    </div>

                                                </label>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </details>
                    }

                </div>

            </div>

        </details>



        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Survivor Perks</h2>

                    <p>
                        @EnabledSurvivorPerksCount de @survivorPerks.Count habilitadas
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorPerks">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorPerks">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="perk-search">
                    <input
                        type="text"
                        placeholder="Buscar Survivor o perk..."
                        @bind="survivorPerkSearch"
                        @bind:event="oninput" />
                </div>

                <div class="settings-perk-list">

                    @foreach (Perk perk in FilteredSurvivorPerks)
                    {
                        <label class="settings-perk-item">

                            <input
                                type="checkbox"
                                checked="@IsSurvivorPerkEnabled(perk.Id)"
                                @onchange="() => ToggleSurvivorPerk(perk.Id)" />

                            <img
                                class="settings-perk-image"
                                src="@perk.Image"
                                alt="@perk.Name" />

                            <div class="settings-visual-item-info">

                                <span class="settings-visual-item-name">
                                    @perk.Name
                                </span>

                                @if (perk.CharacterId.HasValue)
                                {
                                    Survivor? owner = survivors.FirstOrDefault(
                                        s => s.Id == perk.CharacterId.Value);

                                    @if (owner != null)
                                    {
                                        <span class="settings-visual-item-subtitle">
                                            @owner.Name
                                        </span>
                                    }
                                }

                            </div>

                            <div class="settings-tooltip">

                                <strong>
                                    @perk.Name
                                </strong>

                                @if (perk.CharacterId.HasValue)
                                {
                                    Survivor? owner = survivors.FirstOrDefault(
                                        s => s.Id == perk.CharacterId.Value);

                                    @if (owner != null)
                                    {
                                        <span class="settings-tooltip-character">
                                            @owner.Name
                                        </span>
                                    }
                                }

                                <p>
                                    @((MarkupString)perk.Description)
                                </p>

                            </div>

                        </label>
                    }

                </div>

            </div>

        </details>

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Killer Perks</h2>

                    <p>
                        @EnabledKillerPerksCount de @killerPerks.Count habilitadas
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllKillerPerks">
                        HABILITAR TODOS
                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllKillerPerks">
                        DESHABILITAR TODOS
                    </button>

                </div>

                <div class="perk-search">

                    <input
                        type="text"
                        placeholder="Buscar Killer o perk..."
                        @bind="killerPerkSearch"
                        @bind:event="oninput" />

                </div>

                <div class="settings-perk-list">

                    @foreach (Perk perk in FilteredKillerPerks)
                    {
                        <label class="settings-perk-item">

                            <input
                                type="checkbox"
                                checked="@IsKillerPerkEnabled(perk.Id)"
                                @onchange="() => ToggleKillerPerk(perk.Id)" />

                            <img
                                class="settings-perk-image"
                                src="@perk.Image"
                                alt="@perk.Name" />

                            <div class="settings-visual-item-info">

                                <span class="settings-visual-item-name">
                                    @perk.Name
                                </span>

                                @if (perk.CharacterId.HasValue)
                                {
                                    Killer? owner = killers.FirstOrDefault(
                                        k => k.Id == perk.CharacterId.Value);

                                    @if (owner != null)
                                    {
                                        <span class="settings-visual-item-subtitle">
                                            @owner.Name
                                        </span>
                                    }
                                }

                            </div>

                            <div class="settings-tooltip">

                                <strong>
                                    @perk.Name
                                </strong>

                                @if (perk.CharacterId.HasValue)
                                {
                                    Killer? owner = killers.FirstOrDefault(
                                        k => k.Id == perk.CharacterId.Value);

                                    @if (owner != null)
                                    {
                                        <span class="settings-tooltip-character">
                                            @owner.Name
                                        </span>
                                    }
                                }

                                <p>
                                    @((MarkupString)perk.Description)
                                </p>

                            </div>

                        </label>
                    }

                </div>

            </div>

        </details>

        <!-- *=========================* -->
        <!-- SURVIVOR ADD-ONS -->
        <!-- *=========================* -->

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Survivor Add-ons</h2>

                    <p>
                        @EnabledSurvivorAddonsCount de @SurvivorAddons.Count() habilitados
                    </p>

                </div>

            </summary>

            <div class="settings-section-content">

                <div class="settings-actions">

                    <button
                        class="settings-button"
                        @onclick="EnableAllSurvivorAddons">

                        HABILITAR TODOS

                    </button>

                    <button
                        class="settings-button"
                        @onclick="DisableAllSurvivorAddons">

                        DESHABILITAR TODOS

                    </button>

                </div>

                <div class="skin-search">

                    <input
                        type="text"
                        placeholder="Buscar Item o addon..."
                        @bind="survivorAddonSearch"
                        @bind:event="oninput" />

                </div>

                <div class="skin-list">

                    @foreach (Item item in FilteredItemsForSurvivorAddons)
                    {
                        IEnumerable<Addon> itemAddons =
                            GetVisibleSurvivorAddons(item.Id);

                        @if (itemAddons.Any())
                        {
                            <details class="skin-character">

                                <summary>

                                    <strong>@item.Name</strong>

                                </summary>

                                <div class="skin-character-content">

                                    @foreach (Addon addon in itemAddons)
                                    {
                                        <label class="settings-visual-item">

                                            <input
                                                type="checkbox"
                                                checked="@IsAddonEnabled(addon.Id)"
                                                @onchange="() => ToggleAddon(addon.Id)" />

                                            <img
                                                class="settings-item-image"
                                                src="@addon.Image"
                                                alt="@addon.Name" />

                                            <div class="settings-visual-item-info">

                                                <span class="settings-visual-item-name">
                                                    @addon.Name
                                                </span>

                                                <span class="settings-visual-item-subtitle">
                                                    @addon.Rarity
                                                </span>

                                            </div>

                                            <div class="settings-tooltip">

                                                <strong>
                                                    @addon.Name
                                                </strong>

                                                <span class="settings-tooltip-character">
                                                    @addon.Rarity
                                                </span>

                                                <p>
                                                    @((MarkupString)addon.Description)
                                                </p>

                                            </div>

                                        </label>
                                    }

                                </div>

                            </details>
                        }
                    }

                </div>

            </div>

        </details>

        <!-- *=========================* -->
        <!-- KILLER ADD-ONS -->
        <!-- *=========================* -->

        <details class="settings-section">

            <summary class="settings-section-summary">

                <div>

                    <h2>Killer Add-ons</h2>

                    <p>
                        @EnabledKillerAddonsCount de @KillerAddons.Count() habilitados
