    private IEnumerable<IGrouping<int, SkinPiece>> GetVisibleOutfits(int survivorId)
    {
        IEnumerable<SkinPiece> skins = survivorSkins
            .Where(skin => skin.CharacterId == survivorId);

        string search = survivorSkinSearch.Trim();

        if (!string.IsNullOrWhiteSpace(search))
        {
            bool characterMatches = survivors
                .First(s => s.Id == survivorId)
                .Name
                .Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase
                );

            if (!characterMatches)
            {
                // Primero encontramos los outfits que tienen
                // al menos una pieza que coincide con la búsqueda.
                List<int> matchingOutfitIds = skins
                    .Where(skin =>
                        skin.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    .Select(skin => skin.OutfitId)
                    .Distinct()
                    .ToList();

                // Después mostramos TODAS las piezas
                // pertenecientes a esos outfits.
                skins = skins.Where(skin =>
                    matchingOutfitIds.Contains(skin.OutfitId)
                );
            }
        }

        return skins
            .GroupBy(skin => skin.OutfitId)
            .OrderBy(group => group.Key);
    }

