            if (string.IsNullOrWhiteSpace(search))
            {
                return survivors;
            }

            return survivors.Where(survivor =>
                NormalizeSearch(survivor.Name).Contains(search)
                ||
                survivorSkins.Any(skin =>
                    skin.CharacterId == survivor.Id &&
                    NormalizeSearch(skin.Name).Contains(search)
                )
            );
