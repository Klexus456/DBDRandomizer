    private IEnumerable<IGrouping<int, SkinPiece>> GetVisibleKillerOutfits(
        int killerId)
    {
        IEnumerable<SkinPiece> skins = killerSkins
            .Where(skin => skin.CharacterId == killerId);

        string search = killerSkinSearch.Trim();

        if (!string.IsNullOrWhiteSpace(search))
        {
            bool characterMatches = killers
                .First(k => k.Id == killerId)
                .Name
                .Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase
                );

            if (!characterMatches)
            {
                List<int> matchingOutfitIds = skins
                    .Where(skin =>
                        skin.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                    .Select(skin => skin.OutfitId)
                    .Distinct()
                    .ToList();

                skins = skins.Where(skin =>
                    matchingOutfitIds.Contains(skin.OutfitId)
                );
            }
        }

        return skins
            .GroupBy(skin => skin.OutfitId)
            .OrderBy(group => group.Key);
    }

