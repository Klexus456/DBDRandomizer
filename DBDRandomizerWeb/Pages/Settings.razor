    private IEnumerable<Perk> FilteredSurvivorPerks
    {
        get
        {
            string search = survivorPerkSearch.Trim();

            if (string.IsNullOrWhiteSpace(search))
            {
                return survivorPerks;
            }

            return survivorPerks.Where(perk =>
            {
                // Buscar por nombre de perk
                if (perk.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }

                // Buscar por nombre del Survivor
                if (perk.CharacterId.HasValue)
                {
                    Survivor? survivor = survivors.FirstOrDefault(s =>
                        s.Id == perk.CharacterId.Value);

                    if (survivor != null &&
                        survivor.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase))
                    {
                        return true;
                    }
                }

                return false;
            });
        }
    }

