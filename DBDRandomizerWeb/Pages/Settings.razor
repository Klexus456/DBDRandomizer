        return !config.DisabledAddons.Contains(id);
    }

    private void ToggleAddon(int id)
    {
        if (config.DisabledAddons.Contains(id))
        {
            config.DisabledAddons.Remove(id);
        }
        else
        {
            config.DisabledAddons.Add(id);
        }
    }

    private void EnableAllSurvivorAddons()
    {
        foreach (Addon addon in SurvivorAddons)
        {
            config.DisabledAddons.Remove(addon.Id);
        }
    }

    private void DisableAllSurvivorAddons()
    {
        foreach (Addon addon in SurvivorAddons)
        {
            if (!config.DisabledAddons.Contains(addon.Id))
            {
                config.DisabledAddons.Add(addon.Id);
            }
        }
    }

    private void EnableAllKillerAddons()
    {
        foreach (Addon addon in KillerAddons)
        {
            config.DisabledAddons.Remove(addon.Id);
        }
    }

    private void DisableAllKillerAddons()
    {
        foreach (Addon addon in KillerAddons)
        {
            if (!config.DisabledAddons.Contains(addon.Id))
            {
                config.DisabledAddons.Add(addon.Id);
            }
        }
    }

    private int EnabledSurvivorAddonsCount =>
    SurvivorAddons.Count(addon =>
        !config.DisabledAddons.Contains(addon.Id));
    
    private int EnabledKillerAddonsCount =>
    KillerAddons.Count(addon =>
        !config.DisabledAddons.Contains(addon.Id));
    
    // =========================================================
    // OFFERINGS
    // =========================================================

    private bool IsOfferingEnabled(int id)
    {
        return !config.DisabledOfferings.Contains(id);
    }

    private void ToggleOffering(int id)
    {
        if (config.DisabledOfferings.Contains(id))
        {
            config.DisabledOfferings.Remove(id);
        }
        else
        {
            config.DisabledOfferings.Add(id);
        }
    }

    private void EnableAllOfferings()
    {
        config.DisabledOfferings.Clear();
    }

    private void DisableAllOfferings()
    {
        config.DisabledOfferings = offerings
            .Select(offering => offering.Id)
            .ToList();
    }

    private int EnabledOfferingsCount =>
        offerings.Count(offering =>
            !config.DisabledOfferings.Contains(offering.Id));

    // =========================================================
    // OFFERINGS - BÚSQUEDA
    // =========================================================

    private IEnumerable<Offering> FilteredOfferings
    {
        get
        {
            string search = NormalizeSearch(offeringSearch);

            if (string.IsNullOrWhiteSpace(search))
            {
                return offerings;
            }

            return offerings.Where(offering =>
                NormalizeSearch(offering.Name).Contains(search)
            );
        }
    }

    // =========================================================
    // SURVIVORS - BÚSQUEDA
    // =========================================================

    private IEnumerable<Survivor> FilteredSurvivors
    {
        get
        {
            string search = NormalizeSearch(survivorSearch);

            if (string.IsNullOrWhiteSpace(search))
            {
                return survivors;
            }

            return survivors.Where(survivor =>
                NormalizeSearch(survivor.Name).Contains(search)
            );
        }
    }

    // =========================================================
    // KILLERS - BÚSQUEDA
    // =========================================================

    private IEnumerable<Killer> FilteredKillers
    {
        get
        {
            string search = NormalizeSearch(killerSearch);

            if (string.IsNullOrWhiteSpace(search))
            {
                return killers;
            }

            return killers.Where(killer =>
                NormalizeSearch(killer.Name).Contains(search)
            );
        }
    }

    /* 
    ===================================================================
    LOCALSTORAGE
    ===================================================================
    */
    private async Task SaveConfig()
    {
        configSavedSuccessfully = false;

        ValidateConfig();

        if (validationErrors.Count > 0)
        {
            return;
        }

        await LocalStorage.SaveConfig(config);

        configSavedSuccessfully = true;
    }

/* 
===========================================================
Validaciones
===========================================================
*/
    private void ValidateConfig()
    {
        ConfigValidator validator = new(
            survivors,
            survivorSkins,
            killers,
            killerSkins,
            items,
            addons,
            survivorPerks,
            killerPerks,
            offerings,
            config
        );

        validationErrors = validator.Validate();
    }

}
