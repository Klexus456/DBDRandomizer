@page "/diagnostico"

@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using DBDRandomizer.Models


@inject HttpClient Http

<PageTitle>Diagnóstico</PageTitle>

<div class="diagnostics-page">

    <h1>Diagnóstico de datos</h1>

    @if (IsLoading)
    {
        <p>Cargando datos...</p>
    }
    else if (!string.IsNullOrEmpty(LoadError))
    {
        <div class="diagnostics-error">
            <strong>Error al cargar los datos:</strong>
            <p>@LoadError</p>
        </div>
    }
    else
    {
        <div class="diagnostics-summary">

            <div class="summary-box">
                <span class="summary-number">@TotalRecords</span>
                <span class="summary-label">Registros</span>
            </div>

            <div class="summary-box">
                <span class="summary-number">@TotalProblems</span>
                <span class="summary-label">Problemas</span>
            </div>

            <div class="summary-box">
                <span class="summary-number">@MissingImages</span>
                <span class="summary-label">Imágenes con error</span>
            </div>

            <div class="summary-box">
                <span class="summary-number">@EmptyDescriptions</span>
                <span class="summary-label">Descripciones vacías</span>
            </div>

        </div>

        <div class="diagnostics-tabs">

            <button class="@GetTabClass("survivors")"
                    @onclick='() => SelectedTab = "survivors"'>
                Survivors (@Survivors.Count)
            </button>

            <button class="@GetTabClass("killers")"
                    @onclick='() => SelectedTab = "killers"'>
                Killers (@Killers.Count)
            </button>

            <button class="@GetTabClass("survivorperks")"
                    @onclick='() => SelectedTab = "survivorperks"'>
                Survivor Perks (@SurvivorPerks.Count)
            </button>

            <button class="@GetTabClass("killerperks")"
                    @onclick='() => SelectedTab = "killerperks"'>
                Killer Perks (@KillerPerks.Count)
            </button>

            <button class="@GetTabClass("items")"
                    @onclick='() => SelectedTab = "items"'>
                Items (@Items.Count)
            </button>

            <button class="@GetTabClass("addons")"
                    @onclick='() => SelectedTab = "addons"'>
                Addons (@Addons.Count)
            </button>

            <button class="@GetTabClass("offerings")"
                    @onclick='() => SelectedTab = "offerings"'>
                Offerings (@Offerings.Count)
            </button>

            <button class="@GetTabClass("survivorskins")"
                    @onclick='() => SelectedTab = "survivorskins"'>
                Survivor Skins (@SurvivorSkins.Count)
            </button>

            <button class="@GetTabClass("killerskins")"
                    @onclick='() => SelectedTab = "killerskins"'>
                Killer Skins (@KillerSkins.Count)
            </button>

            <button class="@GetTabClass("twov8classes")"
                    @onclick='() => SelectedTab = "twov8classes"'>
                2v8 Classes (@TwoV8Classes.Count)
            </button>

            <button class="@GetTabClass("twov8skills")"
                    @onclick='() => SelectedTab = "twov8skills"'>
                2v8 Skills (@TwoV8Skills.Count)
            </button>

            <button class="@GetTabClass("twov8config")"
                    @onclick='() => SelectedTab = "twov8config"'>
                2v8 Config
            </button>

        </div>

        <div class="diagnostics-toolbar">

            <input type="text"
                   placeholder="Buscar por nombre, ID o imagen..."
                   @bind="SearchText"
                   @bind:event="oninput" />

        </div>

            @if (SelectedTab == "survivors")
            {
                <h2>Survivors</h2>

                <div class="diagnostics-grid">

                    @foreach (var survivor in FilterSurvivors())
                    {
                        <div class="diagnostic-card">

                            @if (EditingItem == survivor)
                            {
                                <div class="diagnostic-info">

                                    <h3>Editar Survivor</h3>

                                    <p>
                                        <strong>ID:</strong> @survivor.Id
                                    </p>

                                    <label>
                                        Nombre:
                                    </label>

                                    <input type="text"
                                        @bind="survivor.Name" />

                                    <label>
                                        Imagen:
                                    </label>

                                    <input type="text"
                                        @bind="survivor.Image" />

                                    @if (!string.IsNullOrEmpty(survivor.Image))
                                    {
                                        <img src="@GetImagePath(survivor.Image)"
                                            alt="@survivor.Name"
                                            class="diagnostic-image"
                                            @onerror="() => RegisterImageError(survivor.Image)" />
                                    }

                                    <div class="diagnostic-edit-buttons">

                                        <button @onclick="SaveCurrentItem"
                                                disabled="@IsSaving">

                                            @(IsSaving ? "Guardando..." : "Guardar")

                                        </button>

                                        <button @onclick="CancelEditing"
                                                disabled="@IsSaving">

                                            Cancelar

                                        </button>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <img src="@GetImagePath(survivor.Image)"
                                    alt="@survivor.Name"
                                    class="diagnostic-image"
                                    @onerror="() => RegisterImageError(survivor.Image)" />

                                <div class="diagnostic-info">

                                    <h3>@survivor.Name</h3>

                                    <p>
                                        <strong>ID:</strong> @survivor.Id
                                    </p>

                                    <p>
                                        <strong>Imagen:</strong><br />
                                        @survivor.Image
                                    </p>

                                    @if (string.IsNullOrWhiteSpace(survivor.Name))
                                    {
                                        <p class="problem">
                                            ⚠ Nombre vacío
                                        </p>
                                    }

                                    @if (string.IsNullOrWhiteSpace(survivor.Image))
                                    {
                                        <p class="problem">
                                            ⚠ Imagen vacía
                                        </p>
                                    }
                                    else if (ImageErrors.Contains(survivor.Image))
                                    {
                                        <p class="problem">
                                            ❌ Imagen no encontrada
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="success">
                                            ✓ Imagen cargada
                                        </p>
                                    }

                                    <button @onclick='() => StartEditing(survivor, "survivors")'>
                                        Editar
                                    </button>

                                </div>
                            }

                        </div>
                    }

                </div>
            }
            else if (SelectedTab == "killers")
            {
                <h2>Killers</h2>

                <div class="diagnostics-grid">

                    @foreach (var killer in FilterKillers())
                    {
                        <div class="diagnostic-card">

                            @if (EditingItem == killer)
                            {
                                <div class="diagnostic-info">

                                    <h3>Editar Killer</h3>

                                    <p>
                                        <strong>ID:</strong> @killer.Id
                                    </p>

                                    <label>
                                        Nombre:
                                    </label>

                                    <input type="text"
                                        @bind="killer.Name" />

                                    <label>
                                        Imagen:
                                    </label>

                                    <input type="text"
                                        @bind="killer.Image" />

                                    @if (!string.IsNullOrEmpty(killer.Image))
                                    {
                                        <img src="@GetImagePath(killer.Image)"
                                            alt="@killer.Name"
                                            class="diagnostic-image"
                                            @onerror="() => RegisterImageError(killer.Image)" />
                                    }

                                    <div class="diagnostic-edit-buttons">

                                        <button @onclick="SaveCurrentItem"
                                                disabled="@IsSaving">

                                            @(IsSaving ? "Guardando..." : "Guardar")

                                        </button>

                                        <button @onclick="CancelEditing"
                                                disabled="@IsSaving">

                                            Cancelar

                                        </button>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <img src="@GetImagePath(killer.Image)"
                                    alt="@killer.Name"
                                    class="diagnostic-image"
                                    @onerror="() => RegisterImageError(killer.Image)" />

                                <div class="diagnostic-info">

                                    <h3>@killer.Name</h3>

                                    <p>
                                        <strong>ID:</strong> @killer.Id
                                    </p>

                                    <p>
                                        <strong>Imagen:</strong><br />
                                        @killer.Image
                                    </p>

                                    @if (string.IsNullOrWhiteSpace(killer.Name))
                                    {
                                        <p class="problem">
                                            ⚠ Nombre vacío
                                        </p>
                                    }

                                    @if (string.IsNullOrWhiteSpace(killer.Image))
                                    {
                                        <p class="problem">
                                            ⚠ Imagen vacía
                                        </p>
                                    }
                                    else if (ImageErrors.Contains(killer.Image))
                                    {
                                        <p class="problem">
                                            ❌ Imagen no encontrada
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="success">
                                            ✓ Imagen cargada
                                        </p>
                                    }

                                    <button @onclick='() => StartEditing(killer, "killers")'>
                                        Editar
                                    </button>

                                </div>
                            }

                        </div>
                    }

                </div>
            }
            else if (SelectedTab == "survivorperks")
            {
                <h2>Survivor Perks</h2>

                <div class="diagnostics-grid">

                    @foreach (var perk in FilterSurvivorPerks())
                    {
                        <div class="diagnostic-card">

                            @if (EditingItem == perk)
                            {
                                <div class="diagnostic-info">

                                    <h3>Editar Survivor Perk</h3>

                                    <p>
                                        <strong>ID:</strong> @perk.Id
                                    </p>

                                    <label>
                                        Nombre:
                                    </label>

                                    <input type="text"
                                        @bind="perk.Name" />

                                    <label>
                                        CharacterId:
                                    </label>

                                    <input type="number"
                                        @bind="perk.CharacterId" />
                                    
                                    @if (perk.CharacterId.HasValue)
                                    {
                                        <p>
                                            <strong>Personaje:</strong>
                                            @GetCharacterName(perk.CharacterId, false)
                                        </p>
                                    }

                                    <label>
                                        Descripción:
                                    </label>

                                    <textarea @bind="perk.Description"></textarea>

                                    <div class="diagnostic-description-preview">

                                        <strong>Vista previa:</strong>

                                        <div class="diagnostic-description-content">
                                            @((MarkupString)perk.Description)
                                        </div>

                                    </div>

                                    <label>
                                        Imagen:
                                    </label>

                                    <input type="text"
                                        @bind="perk.Image" />

                                    @if (!string.IsNullOrEmpty(perk.Image))
                                    {
                                        <img src="@GetImagePath(perk.Image)"
                                            alt="@perk.Name"
                                            class="diagnostic-image"
                                            @onerror="() => RegisterImageError(perk.Image)" />
                                    }

                                    <div class="diagnostic-edit-buttons">

                                        <button @onclick="SaveCurrentItem"
                                                disabled="@IsSaving">

                                            @(IsSaving ? "Guardando..." : "Guardar")

                                        </button>

                                        <button @onclick="CancelEditing"
                                                disabled="@IsSaving">

                                            Cancelar

                                        </button>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <img src="@GetImagePath(perk.Image)"
                                    alt="@perk.Name"
                                    class="diagnostic-image"
                                    @onerror="() => RegisterImageError(perk.Image)" />

                                <div class="diagnostic-info">

                                    <h3>@perk.Name</h3>

                                    <p>
                                        <strong>ID:</strong> @perk.Id
                                    </p>

                                    <p>
                                        <strong>CharacterId:</strong>
                                        @(perk.CharacterId?.ToString() ?? "Ninguno")

                                        @if (perk.CharacterId.HasValue)
                                        {
                                            <span>
                                                — @GetCharacterName(perk.CharacterId,false)
                                            </span>
                                        }
                                    </p>

                                    <p>
                                        <strong>Descripción:</strong>
                                    </p>

                                    @if (string.IsNullOrWhiteSpace(perk.Description))
                                    {
                                        <p class="problem">
                                            ⚠ Descripción vacía
                                        </p>
                                    }
                                    else
                                    {
                                        <div class="diagnostic-description-content">
                                            @((MarkupString)perk.Description)
                                        </div>
                                    }

                                    <p>
                                        <strong>Imagen:</strong><br />
                                        @perk.Image
                                    </p>

                                    @if (string.IsNullOrWhiteSpace(perk.Image))
                                    {
                                        <p class="problem">
                                            ⚠ Imagen vacía
                                        </p>
                                    }
                                    else if (ImageErrors.Contains(perk.Image))
                                    {
                                        <p class="problem">
                                            ❌ Imagen no encontrada
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="success">
                                            ✓ Imagen cargada
                                        </p>
                                    }

                                    @if (perk.CharacterId.HasValue &&
                                        !SurvivorIds.Contains(perk.CharacterId.Value))
                                    {
                                        <p class="problem">
                                            ❌ CharacterId no existe
                                        </p>
                                    }

                                    <button @onclick='() => StartEditing(perk, "survivorperks")'>
                                        Editar
                                    </button>

                                </div>
                            }

                        </div>
                    }
                </div>
            }
        else if (SelectedTab == "killerperks")
        {
            <h2>Killer Perks</h2>

            <div class="diagnostics-grid">

                @foreach (var perk in FilterKillerPerks())
                {
                    <div class="diagnostic-card">

                        @if (EditingItem == perk)
                        {
                            <div class="diagnostic-info">

                                <h3>Editar Killer Perk</h3>

                                <p>
                                    <strong>ID:</strong> @perk.Id
                                </p>

                                <label>
                                    Nombre:
                                </label>

                                <input type="text"
                                    @bind="perk.Name" />

                                <label>
                                    CharacterId:
                                </label>

                                <input type="number"
                                    @bind="perk.CharacterId" />
                                
                                @if (perk.CharacterId.HasValue)
                                {
                                    <p>
                                        <strong>Personaje:</strong>
                                        @GetCharacterName(perk.CharacterId, true)
                                    </p>
                                }

                                <label>
                                    Descripción:
                                </label>

                                <textarea @bind="perk.Description"></textarea>

                                <div class="diagnostic-description-preview">

                                    <strong>Vista previa:</strong>

                                    <div class="diagnostic-description-content">
                                        @((MarkupString)perk.Description)
                                    </div>

                                </div>

                                <label>
                                    Imagen:
                                </label>

                                <input type="text"
                                    @bind="perk.Image" />

                                @if (!string.IsNullOrEmpty(perk.Image))
                                {
                                    <img src="@GetImagePath(perk.Image)"
                                        alt="@perk.Name"
                                        class="diagnostic-image"
                                        @onerror="() => RegisterImageError(perk.Image)" />
                                }

                                <div class="diagnostic-edit-buttons">

                                    <button @onclick="SaveCurrentItem"
                                            disabled="@IsSaving">

                                        @(IsSaving ? "Guardando..." : "Guardar")

                                    </button>

                                    <button @onclick="CancelEditing"
                                            disabled="@IsSaving">

                                        Cancelar

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <img src="@GetImagePath(perk.Image)"
                                alt="@perk.Name"
                                class="diagnostic-image"
                                @onerror="() => RegisterImageError(perk.Image)" />

                            <div class="diagnostic-info">

                                <h3>@perk.Name</h3>

                                <p>
                                    <strong>ID:</strong> @perk.Id
                                </p>

                                <p>
                                    <strong>CharacterId:</strong>
                                    @(perk.CharacterId?.ToString() ?? "Ninguno")

                                    @if (perk.CharacterId.HasValue)
                                    {
                                        <span>
                                            — @GetCharacterName(perk.CharacterId, true)
                                        </span>
                                    }
                                </p>

                                <p>
                                    <strong>Descripción:</strong>
                                </p>

                                @if (string.IsNullOrWhiteSpace(perk.Description))
                                {
                                    <p class="problem">
                                        ⚠ Descripción vacía
                                    </p>
                                }
                                else
                                {
                                    <div class="diagnostic-description-content">
                                        @((MarkupString)perk.Description)
                                    </div>
                                }

                                <p>
                                    <strong>Imagen:</strong><br />
                                    @perk.Image
                                </p>

                                @if (string.IsNullOrWhiteSpace(perk.Image))
                                {
                                    <p class="problem">
                                        ⚠ Imagen vacía
                                    </p>
                                }
                                else if (ImageErrors.Contains(perk.Image))
                                {
                                    <p class="problem">
                                        ❌ Imagen no encontrada
                                    </p>
                                }
                                else
                                {
                                    <p class="success">
                                        ✓ Imagen cargada
                                    </p>
                                }

                                @if (perk.CharacterId.HasValue &&
                                    !KillerIds.Contains(perk.CharacterId.Value))
                                {
                                    <p class="problem">
                                        ❌ CharacterId no existe
                                    </p>
                                }

                                <button @onclick='() => StartEditing(perk, "killerperks")'>
                                    Editar
                                </button>

                            </div>
                        }

                    </div>
                }
            </div>
        }
        else if (SelectedTab == "items")
        {
            <h2>Items</h2>

            <div class="diagnostics-grid">

                @foreach (var item in FilterItems())
                {
                    <div class="diagnostic-card">

                        @if (EditingItem == item)
                        {
                            <div class="diagnostic-info">

                                <h3>Editar Item</h3>

                                <p>
                                    <strong>ID:</strong> @item.Id
                                </p>

                                <label>
                                    Nombre:
                                </label>

                                <input type="text"
                                       @bind="item.Name" />

                                <label>
                                    Rareza:
                                </label>

                                <select @bind="item.Rarity">
                                    @foreach (var rarity in Enum.GetValues<Rarity>())
                                    {
                                        <option value="@rarity">
                                            @rarity
                                        </option>
                                    }
                                </select>

                                <label>
                                    Descripción:
                                </label>

                                <textarea @bind="item.Description"></textarea>

                                <div class="diagnostic-description-preview">
                                    <strong>Vista previa:</strong>

                                    <div class="diagnostic-description-content">
                                        @((MarkupString)item.Description)
                                    </div>
                                </div>

                                <label>
                                    Imagen:
                                </label>

                                <input type="text"
                                       @bind="item.Image" />

                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@GetImagePath(item.Image)"
                                         alt="@item.Name"
                                         class="diagnostic-image"
                                         @onerror="() => RegisterImageError(item.Image)" />
                                }

                                <div class="diagnostic-edit-buttons">

                                    <button @onclick="SaveCurrentItem"
                                            disabled="@IsSaving">

                                        @(IsSaving
                                            ? "Guardando..."
                                            : "Guardar")

                                    </button>

                                    <button @onclick="CancelEditing"
                                            disabled="@IsSaving">

                                        Cancelar

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <img src="@GetImagePath(item.Image)"
                                 alt="@item.Name"
                                 class="diagnostic-image"
                                 @onerror="() => RegisterImageError(item.Image)" />

                            <div class="diagnostic-info">

                                <h3>@item.Name</h3>

                                <p>
                                    <strong>ID:</strong> @item.Id
                                </p>

                                <p>
                                    <strong>Rarity:</strong> @item.Rarity
                                </p>

                                <p>
                                    <strong>Descripción:</strong>
                                </p>

                                @if (string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="problem">
                                        ⚠ Descripción vacía
                                    </p>
                                }
                                else
                                {
                                    <div class="diagnostic-description-content">
                                        @((MarkupString)item.Description)
                                    </div>
                                }

                                <p>
                                    <strong>Imagen:</strong><br />
                                    @item.Image
                                </p>

                                @if (string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <p class="problem">
                                        ⚠ Imagen vacía
                                    </p>
                                }
                                else if (ImageErrors.Contains(item.Image))
                                {
                                    <p class="problem">
                                        ❌ Imagen no encontrada
                                    </p>
                                }
                                else
                                {
                                    <p class="success">
                                        ✓ Imagen cargada
                                    </p>
                                }

                                <button @onclick='() => StartEditing(item, "items")'>
                                    Editar
                                </button>

                            </div>
                        }

                    </div>
                }

            </div>
        }
        else if (SelectedTab == "addons")
        {
            <h2>Addons</h2>

            <div class="diagnostics-grid">

                @foreach (var addon in FilterAddons())
                {
                    <div class="diagnostic-card">

                        @if (EditingItem == addon)
                        {
                            <div class="diagnostic-info">

                                <h3>Editar Addon</h3>

                                <p>
                                    <strong>ID:</strong> @addon.Id
                                </p>

                                <label>
                                    Nombre:
                                </label>

                                <input type="text"
                                       @bind="addon.Name" />

                                <label>
                                    CharacterId:
                                </label>

                                <input type="number"
                                       @bind="addon.CharacterId" />
                                
                                @if (addon.CharacterId.HasValue)
                                {
                                    <p>
                                        <strong>Personaje:</strong>
                                        @GetCharacterName(
                                            addon.CharacterId,
                                            KillerIds.Contains(addon.CharacterId.Value)
                                        )
                                    </p>
                                }

                                <label>
                                    AddonGroupId:
                                </label>

                                <input type="number"
                                    @bind="addon.AddonGroupId" />

                                <label>
                                    Rareza:
                                </label>

                                <select @bind="addon.Rarity">
                                    @foreach (var rarity in Enum.GetValues<Rarity>())
                                    {
                                        <option value="@rarity">
                                            @rarity
                                        </option>
                                    }
                                </select>

                                <label>
                                    Descripción:
                                </label>

                                <textarea @bind="addon.Description"></textarea>

                                <div class="diagnostic-description-preview">
                                    <strong>Vista previa:</strong>

                                    <div class="diagnostic-description-content">
                                        @((MarkupString)addon.Description)
                                    </div>
                                </div>

                                <label>
                                    Imagen:
                                </label>

                                <input type="text"
                                       @bind="addon.Image" />

                                @if (!string.IsNullOrEmpty(addon.Image))
                                {
                                    <img src="@GetImagePath(addon.Image)"
                                         alt="@addon.Name"
                                         class="diagnostic-image"
                                         @onerror="() => RegisterImageError(addon.Image)" />
                                }

                                <div class="diagnostic-edit-buttons">

                                    <button @onclick="SaveCurrentItem"
                                            disabled="@IsSaving">

                                        @(IsSaving
                                            ? "Guardando..."
                                            : "Guardar")

                                    </button>

                                    <button @onclick="CancelEditing"
                                            disabled="@IsSaving">

                                        Cancelar

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <img src="@GetImagePath(addon.Image)"
                                 alt="@addon.Name"
                                 class="diagnostic-image"
                                 @onerror="() => RegisterImageError(addon.Image)" />

                            <div class="diagnostic-info">

                                <h3>@addon.Name</h3>

                                <p>
                                    <strong>ID:</strong> @addon.Id
                                </p>

                                <p>
                                    <strong>CharacterId:</strong>
                                    @(addon.CharacterId?.ToString() ?? "Ninguno")

                                    @if (addon.CharacterId.HasValue)
                                    {
                                        <span>
                                            —
                                            @GetCharacterName(
                                                addon.CharacterId,
                                                KillerIds.Contains(addon.CharacterId.Value)
                                            )
                                        </span>
                                    }
                                </p>

                                @if (addon.AddonGroupId.HasValue)
                                {
                                    var groupItems = Items
                                        .Where(x => x.AddonGroupId == addon.AddonGroupId.Value)
                                        .ToList();

                                    <p>
                                        <strong>AddonGroupId:</strong>
                                        @addon.AddonGroupId
