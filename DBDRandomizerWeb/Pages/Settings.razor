    private IEnumerable<IGrouping<int, SkinPiece>> GetVisibleKillerOutfits(int killerId)
    {
        IEnumerable<SkinPiece> skins = killerSkins
            .Where(skin => skin.CharacterId == killerId);

        string search = NormalizeSearch(killerSkinSearch);

        if (string.IsNullOrWhiteSpace(search))
        {
            return skins
                .GroupBy(skin => skin.OutfitId)
                .OrderBy(group => group.Key);
        }

        bool characterMatches = NormalizeSearch(
            killers.First(k => k.Id == killerId).Name
        ).Contains(search);

        if (!characterMatches)
        {
            List<int> matchingOutfitIds = skins
                .Where(skin =>
                    NormalizeSearch(skin.Name).Contains(search)
                )
                .Select(skin => skin.OutfitId)
                .Distinct()
                .ToList();

            skins = skins.Where(skin =>
                matchingOutfitIds.Contains(skin.OutfitId)
            );
        }

        return skins
            .GroupBy(skin => skin.OutfitId)
            .OrderBy(group => group.Key);
    }

