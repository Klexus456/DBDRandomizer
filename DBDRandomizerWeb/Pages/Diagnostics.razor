                    <h3>Killers disponibles en 2v8</h3>

                    <p>
                        Configuración de Killers que pueden aparecer
                        en el randomizer 2v8.
                    </p>

                    @foreach (var killerId in TwoV8Config.Killers)
                    {
                        <div class="diagnostic-config-row">

                            <span>
                                <strong>ID:</strong> @killerId
                            </span>

                            <span>
                                @GetCharacterName(killerId, true)
                            </span>

                            @if (!KillerIds.Contains(killerId))
                            {
                                <span class="problem">
                                    ❌ Killer inexistente
                                </span>
                            }
                            else
                            {
                                <span class="success">
                                    ✓ Correcto
                                </span>
                            }

                        </div>
                    }

                    <label>
                        IDs de Killers (separados por coma):
                    </label>

                    <input type="text"
                        value="@string.Join(", ", TwoV8Config.Killers)"
                        @onchange="UpdateTwoV8KillerConfig" />

                    <div class="diagnostic-edit-buttons">

                        <button @onclick="SaveTwoV8Config"
                                disabled="@IsSaving">

                            @(IsSaving
                                ? "Guardando..."
                                : "Guardar")

                        </button>

                    </div>

                </div>

            </div>
        }
    }

</div>

@code {

    private bool IsLoading = true;
    private string? LoadError;

    private string SelectedTab = "survivors";
    private string SearchText = "";

    private List<Survivor> Survivors = new();
    private List<Killer> Killers = new();

    private List<Perk> SurvivorPerks = new();
    private List<Perk> KillerPerks = new();

    private List<Item> Items = new();
    private List<Addon> Addons = new();
    private List<Offering> Offerings = new();

    private List<SkinPiece> SurvivorSkins = new();
    private List<SkinPiece> KillerSkins = new();
    
    private List<TwoV8Class> TwoV8Classes = new();
    private List<TwoV8Skill> TwoV8Skills = new();
    private TwoV8Config TwoV8Config = new();

    private HashSet<string> ImageErrors = new();
    private object? EditingItem;
    private string EditingTab = "";
    private string SaveMessage = "";
    private bool IsSaving = false;
    private string? EditingBackupJson;

    private readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters =
        {
            new JsonStringEnumConverter()
        }
    };

    private HashSet<int> SurvivorIds =>
        Survivors.Select(x => x.Id).ToHashSet();

    private HashSet<int> KillerIds =>
        Killers.Select(x => x.Id).ToHashSet();

    private HashSet<int> AllCharacterIds =>
        Survivors
            .Select(x => x.Id)
            .Concat(Killers.Select(x => x.Id))
            .ToHashSet();

    private int TotalRecords =>
        Survivors.Count +
        Killers.Count +
        SurvivorPerks.Count +
        KillerPerks.Count +
        Items.Count +
        Addons.Count +
        Offerings.Count +
        SurvivorSkins.Count +
        KillerSkins.Count +
        TwoV8Classes.Count +
        TwoV8Skills.Count +
        TwoV8Config.Killers.Count;

    private int MissingImages =>
        ImageErrors.Count;

    private int EmptyDescriptions =>
        SurvivorPerks.Count(x => string.IsNullOrWhiteSpace(x.Description)) +
        KillerPerks.Count(x => string.IsNullOrWhiteSpace(x.Description)) +
        Items.Count(x => string.IsNullOrWhiteSpace(x.Description)) +
        Addons.Count(x => string.IsNullOrWhiteSpace(x.Description)) +
        Offerings.Count(x => string.IsNullOrWhiteSpace(x.Description)) +
        TwoV8Skills.Count(x => string.IsNullOrWhiteSpace(x.Description));

    private int TotalProblems =>
        MissingImages +
        EmptyDescriptions +
        CountDuplicateIds();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Survivors = await LoadJson<List<Survivor>>(
                "data/survivors.json");

            Killers = await LoadJson<List<Killer>>(
                "data/killers.json");

            SurvivorPerks = await LoadJson<List<Perk>>(
                "data/perks_survivor.json");

            KillerPerks = await LoadJson<List<Perk>>(
                "data/perks_killer.json");

            Items = await LoadJson<List<Item>>(
                "data/items.json");

            Addons = await LoadJson<List<Addon>>(
                "data/addons.json");

            Offerings = await LoadJson<List<Offering>>(
                "data/offerings.json");

            SurvivorSkins = await LoadJson<List<SkinPiece>>(
                "data/survivor_skins.json");

            KillerSkins = await LoadJson<List<SkinPiece>>(
                "data/killer_skins.json");
            
            TwoV8Classes = await LoadJson<List<TwoV8Class>>(
                "data/two_v8_classes.json");

            TwoV8Skills = await LoadJson<List<TwoV8Skill>>(
                "data/two_v8_skills.json");

            TwoV8Config = await LoadJson<TwoV8Config>(
                "data/two_v8_config.json");
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task<T> LoadJson<T>(string path)
    {
        return await Http.GetFromJsonAsync<T>(path, JsonOptions)
               ?? throw new Exception(
                   $"El archivo {path} está vacío o no pudo ser leído.");
    }

    private string GetTabClass(string tab)
    {
        return SelectedTab == tab
            ? "diagnostics-tab active"
            : "diagnostics-tab";
    }

    private string GetImagePath(string image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "";

        if (image.StartsWith("/"))
            return image;

        return "/" + image;
    }

    private void RegisterImageError(string image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return;

        if (ImageErrors.Add(image))
        {
            StateHasChanged();
        }
    }

    private void StartEditing(object item, string tab)
    {
        EditingItem = item;
        EditingTab = tab;

        EditingBackupJson = JsonSerializer.Serialize(
            item,
            item.GetType(),
            JsonOptions
        );

        SaveMessage = "";
    }

    private void CancelEditing()
    {
        if (EditingItem != null && EditingBackupJson != null)
        {
            var restored = JsonSerializer.Deserialize(
                EditingBackupJson,
                EditingItem.GetType(),
                JsonOptions
            );

            if (restored != null)
            {
                var properties = EditingItem.GetType().GetProperties();

                foreach (var property in properties)
                {
                    if (!property.CanRead || !property.CanWrite)
                        continue;

                    property.SetValue(
                        EditingItem,
                        property.GetValue(restored)
                    );
                }
            }
        }

        EditingItem = null;
        EditingTab = "";
        EditingBackupJson = null;
        SaveMessage = "";
    }

    private async Task SaveCurrentItem()
    {
        if (EditingItem == null || string.IsNullOrEmpty(EditingTab))
            return;

        IsSaving = true;
        SaveMessage = "";

        try
        {
            string fileName = EditingTab switch
            {
                "survivors" => "survivors.json",
                "killers" => "killers.json",
                "survivorperks" => "perks_survivor.json",
                "killerperks" => "perks_killer.json",
                "items" => "items.json",
                "addons" => "addons.json",
                "offerings" => "offerings.json",
                "survivorskins" => "survivor_skins.json",
                "killerskins" => "killer_skins.json",
                "twov8classes" => "two_v8_classes.json",
                "twov8skills" => "two_v8_skills.json",
                _ => throw new InvalidOperationException("Tipo de datos desconocido.")
            };

            List<object> data = EditingTab switch
            {
                "survivors" => Survivors.Cast<object>().ToList(),
                "killers" => Killers.Cast<object>().ToList(),
                "survivorperks" => SurvivorPerks.Cast<object>().ToList(),
                "killerperks" => KillerPerks.Cast<object>().ToList(),
                "items" => Items.Cast<object>().ToList(),
                "addons" => Addons.Cast<object>().ToList(),
                "offerings" => Offerings.Cast<object>().ToList(),
                "survivorskins" => SurvivorSkins.Cast<object>().ToList(),
                "killerskins" => KillerSkins.Cast<object>().ToList(),
                "twov8classes" => TwoV8Classes.Cast<object>().ToList(),
                "twov8skills" => TwoV8Skills.Cast<object>().ToList(),
                _ => throw new InvalidOperationException("Tipo de datos desconocido.")
            };

            var jsonOptions = new JsonSerializerOptions
            {
                WriteIndented = true,
                Converters =
                {
                    new JsonStringEnumConverter()
                }
            };

            string json = JsonSerializer.Serialize(data, jsonOptions);

            using var content = new StringContent(
                json,
                Encoding.UTF8,
                "application/json"
            );

            var response = await Http.PutAsync(
                $"api/data/{fileName}",
                content
            );

            if (!response.IsSuccessStatusCode)
            {
                string error = await response.Content.ReadAsStringAsync();

                SaveMessage =
                    $"Error al guardar: {error}";

                return;
            }

            SaveMessage = "✓ Cambios guardados correctamente.";

            EditingItem = null;
            EditingTab = "";
            EditingBackupJson = null;

            ImageErrors.Clear();
        }
        catch (Exception ex)
        {
            SaveMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private bool MatchesSearch(
        int id,
        string name,
        string image)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
            return true;

        string search = SearchText.Trim().ToLowerInvariant();

        return id.ToString().Contains(search) ||
               name.ToLowerInvariant().Contains(search) ||
               image.ToLowerInvariant().Contains(search);
    }

    private IEnumerable<Survivor> FilterSurvivors()
    {
        return Survivors.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Killer> FilterKillers()
    {
        return Killers.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Perk> FilterSurvivorPerks()
    {
        return SurvivorPerks.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Perk> FilterKillerPerks()
    {
        return KillerPerks.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Item> FilterItems()
    {
        return Items.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Addon> FilterAddons()
    {
        return Addons.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<Offering> FilterOfferings()
    {
        return Offerings.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<SkinPiece> FilterSurvivorSkins()
    {
        return SurvivorSkins.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<SkinPiece> FilterKillerSkins()
    {
        return KillerSkins.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<TwoV8Class> FilterTwoV8Classes()
    {
        return TwoV8Classes.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private IEnumerable<TwoV8Skill> FilterTwoV8Skills()
    {
        return TwoV8Skills.Where(x =>
            MatchesSearch(x.Id, x.Name, x.Image));
    }

    private int CountDuplicateIds()
    {
        int count = 0;

        count += CountDuplicates(Survivors.Select(x => x.Id));
        count += CountDuplicates(Killers.Select(x => x.Id));
        count += CountDuplicates(SurvivorPerks.Select(x => x.Id));
        count += CountDuplicates(KillerPerks.Select(x => x.Id));
        count += CountDuplicates(Items.Select(x => x.Id));
        count += CountDuplicates(Addons.Select(x => x.Id));
        count += CountDuplicates(Offerings.Select(x => x.Id));
        count += CountDuplicates(SurvivorSkins.Select(x => x.Id));
        count += CountDuplicates(KillerSkins.Select(x => x.Id));
        count += CountDuplicates(TwoV8Classes.Select(x => x.Id));
        count += CountDuplicates(TwoV8Skills.Select(x => x.Id));

        return count;
    }

    private int CountDuplicates(IEnumerable<int> ids)
    {
        return ids
            .GroupBy(x => x)
            .Count(x => x.Count() > 1);
    }

    private string GetCharacterName(int? characterId, bool isKiller)
    {
        if (!characterId.HasValue)
            return "Ninguno";

        if (isKiller)
        {
            var killer = Killers.FirstOrDefault(
                x => x.Id == characterId.Value);

            return killer?.Name ?? "CharacterId no existe";
        }
        else
        {
            var survivor = Survivors.FirstOrDefault(
                x => x.Id == characterId.Value);

            return survivor?.Name ?? "CharacterId no existe";
        }
    }

    private string GetTwoV8ClassName(int classId)
    {
        return TwoV8Classes
            .FirstOrDefault(x => x.Id == classId)
            ?.Name
            ?? "ClassId no existe";
    }

    private void UpdateTwoV8KillerConfig(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";

        List<int> ids = new();

        foreach (string part in value.Split(','))
        {
            if (int.TryParse(part.Trim(), out int id))
            {
                ids.Add(id);
            }
        }

        TwoV8Config.Killers = ids;
    }

    private async Task SaveTwoV8Config()
    {
        IsSaving = true;
        SaveMessage = "";

        try
        {
            var jsonOptions = new JsonSerializerOptions
            {
                WriteIndented = true
            };

            string json = JsonSerializer.Serialize(
                TwoV8Config,
                jsonOptions
            );

            using var content = new StringContent(
                json,
                Encoding.UTF8,
                "application/json"
            );

            var response = await Http.PutAsync(
                "api/data/two_v8_config.json",
                content
            );

            if (!response.IsSuccessStatusCode)
            {
                string error =
                    await response.Content.ReadAsStringAsync();

                SaveMessage =
                    $"Error al guardar: {error}";

                return;
            }

            SaveMessage =
                "✓ Cambios guardados correctamente.";
        }
        catch (Exception ex)
        {
            SaveMessage =
                $"Error al guardar: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }
}